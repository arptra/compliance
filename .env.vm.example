# Copy this file to .env.vm in the repository root and edit it once.
# start_vm.sh, start_vm_https.sh and restart_vm.sh load .env.vm automatically.
# Values are literal: no shell commands, variable expansion or backslash escapes.
# Environment variables supplied when launching take precedence over this file.

PUBLIC_HOST=your.domain
HTTPS_ENABLED=1
TLS_CERT_FILE=/path/to/fullchain.pem
TLS_KEY_FILE=/path/to/privkey.pem

# Or use the default certificate locations in the project:
# TLS_CERT_FILE=certs/server/fullchain.pem
# TLS_KEY_FILE=certs/server/privkey.pem

# Optional: intermediate CA bundle if TLS_CERT_FILE contains only the server cert.
# TLS_CHAIN_FILE=/path/to/intermediates.pem
# Optional: corporate CA trusted by the dashboard's HTTPS proxy to API.
# TLS_CA_FILE=/path/to/root-ca.pem
# Optional: password for an encrypted private key. Quote spaces or # characters.
# TLS_KEY_PASSWORD='your password'

API_PORT=18000
DASHBOARD_PORT=15173
# Optional: GigaChat CA bundle when it is not stored at certs/ca.pem.
# GIGACHAT_CA_BUNDLE_FILE=/path/to/gigachat-ca.pem
