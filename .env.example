GIGACHAT_CA_BUNDLE_FILE=certs/ca.pem
GIGACHAT_CERT_FILE=certs/client.pem
GIGACHAT_KEY_FILE=certs/client.key
GIGACHAT_KEY_PASSWORD=
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# Optional overrides for config llm.*
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=true
# Fast fallback when HTTP 429 has no Retry-After header.
GIGACHAT_RETRY_BASE_DELAY_SECONDS=0.05
GIGACHAT_RETRY_MAX_DELAY_SECONDS=1.0
# Optional: override name of env var that stores key password
GIGACHAT_KEY_PASSWORD_ENV=GIGACHAT_KEY_PASSWORD

# VM server HTTPS settings (export in the shell; VM scripts do not auto-load .env).
# HTTPS_ENABLED=1 is the default for start_vm.sh / restart_vm.sh.
# PUBLIC_HOST=dashboard.example.com
# TLS_CERT_FILE=certs/server/fullchain.pem
# TLS_KEY_FILE=certs/server/privkey.pem
# Optional: append intermediate CA certificates to TLS_CERT_FILE (leaf first).
# TLS_CHAIN_FILE=certs/server/intermediates.pem
# Optional: encrypted server key password, passed via environment only.
# TLS_KEY_PASSWORD=
# Optional: CA trust for the dashboard's HTTPS proxy to API (e.g. corporate root).
# TLS_CA_FILE=certs/server/root-ca.pem
